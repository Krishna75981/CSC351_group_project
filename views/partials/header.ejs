<%#
  Name:       Jackson [last name]
  Course:     CSC351 Database Management
  Date:       2026-11-12
  Assignment: Semester project
  Purpose:    Shared page header. Opens the HTML document, shows the nav bar
              and an optional status message, and opens <main>. Every page
              starts with it and ends with footer.ejs.

  Locals (all optional):
    title        Page title, shown in the browser tab
    currentUser  { id, firstName } when logged in (set by Noah in res.locals)
    currentPath  req.path, used to highlight the active nav link
    message      { type: 'success' | 'error' | 'info', text } for a banner

  Usage, from a view in views/<feature>/, inside an unescaped output tag:
    include('../partials/header', { title: 'Find clubs' })
%>
<%
  const path = locals.currentPath || '';
  const isActive = (href) => path === href || path.startsWith(href + '/');
  const navLink = (href, label) =>
    `<a href="${href}" class="nav-link${isActive(href) ? ' is-active' : ''}"` +
    `${isActive(href) ? ' aria-current="page"' : ''}>${label}</a>`;
  const user = locals.currentUser;
%>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= locals.title ? title + ' · Chess Club Finder' : 'Chess Club Finder' %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="container site-header__inner">
      <a href="/" class="brand">
        <span class="brand__mark" aria-hidden="true">&#9822;</span>
        <span class="brand__name">Chess Club Finder</span>
      </a>

      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="visually-hidden">Menu</span>
        <span class="nav-toggle__bar" aria-hidden="true"></span>
      </button>

      <nav id="site-nav" class="site-nav" aria-label="Main">
        <div class="site-nav__links">
          <%- navLink('/clubs', 'Clubs') %>
          <%- navLink('/meetups', 'Meetups') %>
          <%- navLink('/venues', 'Venues') %>
          <%- navLink('/players', 'Players') %>
        </div>

        <div class="site-nav__account">
          <% if (user) { %>
            <%- navLink('/my/clubs', 'My clubs') %>
            <%- navLink('/my/meetups', 'My meetups') %>
            <%- navLink('/invitations', 'Invitations') %>
            <a href="/profile" class="nav-user<%= isActive('/profile') ? ' is-active' : '' %>">
              <%= user.firstName %>
            </a>
            <form action="/logout" method="post" class="nav-logout">
              <button type="submit" class="btn btn--ghost btn--sm">Log out</button>
            </form>
          <% } else { %>
            <a href="/login" class="nav-link">Log in</a>
            <a href="/register" class="btn btn--primary btn--sm">Register</a>
          <% } %>
        </div>
      </nav>
    </div>
  </header>

  <main id="main" class="container site-main">
    <% if (locals.message && message.text) { %>
      <div class="alert alert--<%= message.type || 'info' %>" role="<%= message.type === 'error' ? 'alert' : 'status' %>">
        <%= message.text %>
      </div>
    <% } %>
